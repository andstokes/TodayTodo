<Window x:Class="TodayChecklist.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodayChecklist.ViewModels"
        Title="历史记录"
        Icon="Assets/TodayChecklist.ico"
        Width="440"
        Height="620"
        MinWidth="340"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <SolidColorBrush x:Key="PageBrush" Color="#FFF7F9FC" />
    <SolidColorBrush x:Key="TaskBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SoftBrush" Color="#FFE9EEF5" />
    <SolidColorBrush x:Key="LineBrush" Color="#FFD9E1EC" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF253247" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF69788F" />
  </Window.Resources>

  <Grid Background="{DynamicResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="20,18,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Viewbox Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
        <Canvas Width="24" Height="24">
          <Rectangle Canvas.Left="3"
                     Canvas.Top="5"
                     Width="18"
                     Height="16"
                     RadiusX="2"
                     RadiusY="2"
                     Fill="Transparent"
                     Stroke="{DynamicResource PrimaryTextBrush}"
                     StrokeThickness="1.8" />
          <Line X1="3" Y1="10" X2="21" Y2="10"
                Stroke="{DynamicResource PrimaryTextBrush}"
                StrokeThickness="1.8" />
          <Line X1="8" Y1="3" X2="8" Y2="7"
                Stroke="{DynamicResource PrimaryTextBrush}"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
          <Line X1="16" Y1="3" X2="16" Y2="7"
                Stroke="{DynamicResource PrimaryTextBrush}"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
          <Path Stroke="{DynamicResource PrimaryTextBrush}"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Data="M7,15 L10.2,18 L17,12.5" />
        </Canvas>
      </Viewbox>
      <TextBlock Grid.Column="1"
                 Text="历史记录"
                 FontSize="20"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="20,0,20,20">
        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryDayViewModel}">
              <StackPanel Margin="0,0,0,20">
                <Grid Margin="2,0,2,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DateText}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding CompletedCountText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryTaskItemViewModel}">
                      <Border Background="{DynamicResource TaskBrush}"
                              BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="11,9"
                              Margin="0,0,0,6">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
                          <TextBlock Text="{Binding Notes}"
                                     Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                     FontSize="12"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="28">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding DayCount}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="还没有历史记录"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="完成的任务会在日期更新后显示在这里。"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
