<Window x:Class="TodayChecklist.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日清单设置"
        Icon="Assets/TodayChecklist.ico"
        Width="470"
        Height="670"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="显示方式" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Margin="0,7,0,18">
      <ComboBox x:Name="DisplayModeBox" SelectionChanged="DisplayModeBox_SelectionChanged">
        <ComboBoxItem Content="标准模式（普通窗口层级，不置顶）" />
        <ComboBoxItem Content="桌面模式（实验性，位于桌面图标下方）" />
      </ComboBox>
      <TextBlock x:Name="DesktopWarning"
                 Margin="0,7,0,0"
                 Foreground="#FF9A681D"
                 TextWrapping="Wrap"
                 Text="桌面模式依赖 Windows Explorer 的未公开窗口结构；若连接失败，程序会自动退回标准模式，不会重启或修改 Explorer。"
                 Visibility="Collapsed" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="主题" VerticalAlignment="Center" FontWeight="SemiBold" />
      <ComboBox x:Name="ThemeBox" Grid.Column="1">
        <ComboBoxItem Content="跟随程序默认" />
        <ComboBoxItem Content="浅色" />
        <ComboBoxItem Content="深色" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="46" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="窗口不透明度" VerticalAlignment="Center" FontWeight="SemiBold" />
      <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.75" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" />
      <TextBlock Grid.Column="2" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,0,0,18">
      <TextBlock Text="数据保存位置" FontWeight="SemiBold" />
      <TextBox x:Name="DataPathBox"
               Margin="0,7,0,7"
               Padding="7"
               IsReadOnly="True"
               TextWrapping="NoWrap"
               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="SelectDataLocationButton" Content="选择位置…" Click="SelectDataLocationButton_Click" Padding="12,6" Margin="0,0,8,0" />
        <Button x:Name="RestoreDefaultLocationButton" Content="恢复默认位置" Click="RestoreDefaultLocationButton_Click" Padding="12,6" />
      </StackPanel>
      <TextBlock Margin="0,7,0,0"
                 Foreground="#FF65758B"
                 TextWrapping="Wrap"
                 Text="选择父文件夹后，程序会在其中创建 TodayChecklist 子目录。路径变更需安全迁移并重新启动。" />
    </StackPanel>

    <StackPanel Grid.Row="5">
      <CheckBox x:Name="ShowRolloverDaysBox" Content="显示任务的“已顺延 N 天”" Margin="0,0,0,12" />
      <CheckBox x:Name="ShowDayDividersBox" Content="显示上午／下午／晚上分隔线" Margin="0,0,0,7" />
      <TextBlock Text="也可点击主界面底部的分隔线图标或按 Ctrl+Shift+D 切换。"
                 TextWrapping="Wrap" Foreground="#FF65758B" Margin="0,0,0,12" />
      <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动（仅当前用户）" Margin="0,0,0,12" />
      <CheckBox x:Name="CloseToTrayBox" Content="关闭/隐藏按钮将程序收进系统托盘" />
      <TextBlock Margin="0,16,0,0" Foreground="#FF65758B" TextWrapping="Wrap"
                 Text="任务、备份、设置和日志保存在上方目录。程序不联网、不收集遥测，也不会修改注册表。" />
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
      <Button Content="保存" IsDefault="True" Padding="16,7" Click="SaveButton_Click" />
    </StackPanel>
  </Grid>
</Window>
