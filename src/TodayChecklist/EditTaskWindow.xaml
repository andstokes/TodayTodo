<Window x:Class="TodayChecklist.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务"
        Icon="Assets/TodayChecklist.ico"
        Width="420"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="标题" FontWeight="SemiBold" />
    <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,6,0,14" MaxLength="200" Padding="8" />
    <StackPanel Grid.Row="2">
      <TextBlock Text="备注" FontWeight="SemiBold" />
      <TextBox x:Name="NotesBox"
               Margin="0,6,0,0"
               MaxLength="2000"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               MinHeight="110"
               Padding="8" />
    </StackPanel>
    <CheckBox x:Name="ApplyToSeriesBox"
              Grid.Row="3"
              Content="同时更新以后生成的重复任务"
              Margin="0,12,0,0" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
      <Button Content="保存" IsDefault="True" Padding="16,7" Click="SaveButton_Click" />
    </StackPanel>
  </Grid>
</Window>
